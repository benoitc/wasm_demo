%% -*- erlang -*-
{erl_opts, [debug_info]}.

%% The OTP application is `wasm'; the Hex package is `erlang_wasm'. The actor
%% API is not on Hex yet, so this pins the exact runtime commit that
%% `wasm_demo:actor_demo/0' was checked against. Pin the Hex release that
%% ships it once it is published.
{deps, [{wasm, {git, "https://github.com/benoitc/erlang_wasm.git",
                {ref, "08e0b98d35fb088d32feb0e485678cbed6a9353e"}}}]}.

%% Boot the app, and `wasm' with it, in `rebar3 shell', so a component is
%% compiled once through the module cache `wasm' runs. Without it a component
%% still works and compiles inline.
{shell, [{apps, [wasm_demo]}]}.
