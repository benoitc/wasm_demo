%% -*- erlang -*-
{erl_opts, [debug_info]}.

%% The OTP application is `wasm'; the Hex package is `erlang_wasm'.
{deps, [{wasm, "0.9.0", {pkg, erlang_wasm}}]}.

%% Boot the app, and `wasm' with it, in `rebar3 shell': components go through
%% the module cache that `wasm' runs.
{shell, [{apps, [wasm_demo]}]}.
