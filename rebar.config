%% -*- erlang -*-
{erl_opts, [debug_info]}.

%% The OTP application is `wasm'; the Hex package is `erlang_wasm'.
{deps, [{wasm, "0.9.1", {pkg, erlang_wasm}}]}.

%% Boot the app, and `wasm' with it, in `rebar3 shell', so a component is
%% compiled once through the module cache `wasm' runs. Without it a component
%% still works and compiles inline.
{shell, [{apps, [wasm_demo]}]}.
